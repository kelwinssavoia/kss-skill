{
  "name": "kss-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for KSS: open a project, run phases in Claude Code or Codex, parallel sessions on worktrees, subagent inspector, QA.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "icon": "electron scripts/icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "install-app": "npm run dist && node scripts/install-app.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "dev.kss.desktop",
    "productName": "KSS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "identity": null
    }
  }
}
